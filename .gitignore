# 환경변수·시크릿 — 절대 커밋 금지
.env
.env.*
!.env.example
*.pem
*.key

# Python
.pytest_cache/
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
.ipynb_checkpoints/

# Node
node_modules/
dist/
build/
.next/
.turbo/

# OS / IDE
.DS_Store
.idea/
