# 로그
*.log

# 원문 스냅샷은 data/corpus.tar.gz 한 파일로 커밋하고, 풀린 폴더는 커밋하지 않는다(backend/rag/ingest/snapshot.py, data/data.md)
data/corpus/
data/corpus.tmp/

# 다시 만들 수 있는 중간 결과물(원문 압축·manifest·chunks_index만 커밋, data/data.md)
data/parsed/*
# 결정표 변환이 실행 중에 읽고 시험도 읽는 권한표 칸만 커밋한다(backend/graph/decision/routes.py AUTHZ_CELLS_FILE, 이미지에 들어가야 한다)
!data/parsed/authz_cells.jsonl
data/chunks/
data/index_exp/
# 검색 색인(청크·벡터 약 130MB)은 data/index.tar.gz 한 파일로 커밋하고, 풀린 폴더는 커밋하지 않는다(backend/rag/ingest/snapshot.py, data/data.md)
data/index/
data/index.tmp/
# 검색 1차 비교 조합별 결과는 results.tar.gz로 커밋한다. 푼 파일은 커밋하지 않는다
evals/results/retrieval_v1_round1/[0-9a-f]*.json
evals/results/retrieval_v1_round1_frozen/[0-9a-f]*.json
